# Supabase 專案設定(在 Supabase Dashboard > Project Settings > API 取得)

# Project URL,不是秘密,前端後端都會用到
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# anon public key,設計上就是可以公開的,登入功能會用到
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key 是真正的機密,只能在伺服器端用,絕對不能加上 NEXT_PUBLIC_ 前綴曝露給瀏覽器
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LINE 官方帳號設定(LINE Developers Console > 你的 Messaging API channel)
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret
# 團隊 LINE 群組的 ID,拿法:把官方帳號拉進群組(或群裡發一則訊息),
# 去 Vercel 的 Function Logs 找 app/api/line/webhook 印出來的 groupId
LINE_GROUP_ID=your-line-group-id

# 隨便設一組亂數字串就好,用來擋掉「/api/cron/reminders 這個網址被別人亂打」——
# 只有帶對這組密鑰的請求才會真的觸發發送提醒。設定完要記得也在 Vercel 專案的
# 環境變數裡加上同一個值,Vercel Cron 觸發時才會自動帶上正確的 Authorization header。
CRON_SECRET=your-random-secret
